# Скопируйте в .env и заполните. Файл .env в Git не коммитим.

# Адрес API СМП/НМП без завершающего слэша.
# Для разработки — локальная заглушка mock_api.py:
API_BASE_URL=http://127.0.0.1:5001

# Токен авторизации (если API требует; уйдёт как "Authorization: Bearer ...")
API_TOKEN=

# Таймаут одного запроса к API, секунды
API_TIMEOUT=5

# Ссылка на портал врача (открывается в новой вкладке)
DOCTOR_PORTAL_URL=https://example.org/doctor-portal

# Секретный ключ сессии. Лучше задать свой; если пусто, приложение создаст файл data/secret.key
# (сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Логи
LOG_DIR=logs
LOG_LEVEL=INFO

# Карта в карточке вызова. Для закрытого контура укажите свой сервер плиток.
MAP_ENABLED=1
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© участники OpenStreetMap
MAP_ZOOM=16

# Локальная SQL-база (SQLite): пользователи, роли, журнал действий
DB_PATH=data/app.db

# Сессия входа: сколько часов действует; блокировка после N неверных паролей на M минут
SESSION_HOURS=24
# 1, если приложение открывается по HTTPS
SESSION_COOKIE_SECURE=
# 1, если перед приложением стоит nginx или другой прокси
TRUST_PROXY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# Порт mock_api.py
MOCK_PORT=5001
